# Avir Environmental Intelligence - Environment Configuration
# Step 3: Multi-Source Provenance & Environmental Data Quality

# OpenAQ API v3 Key (Server-Side Only — strictly kept on the server)
# Used by /api/telemetry/sources to query global physical reference and research monitors.
# Get a free key at: https://openaq.org/
OPENAQ_API_KEY=your_openaq_api_key_here

# Open Government Data (OGD) Platform India API Key (Server-Side Only)
# Used by /api/telemetry/cpcb to query official CPCB/CAAQMS real-time air quality records.
# Register and generate a key at: https://data.gov.in/
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here

# Google Gemini API Key (Optional — for AI-driven health routine optimization)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
